<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexora.system.mapper.SysDictDataMapper">
    <select id="selectOrdered" resultType="com.nexora.system.entity.SysDictData">
        SELECT *
        FROM sys_dict_data
        ${ew.customSqlSegment}
        ORDER BY sort ASC, id ASC
    </select>
</mapper>
