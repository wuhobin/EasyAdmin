# Docker port mapping
BACKEND_PORT=8800

# Spring Boot
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8800
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
LOG_PATH=/app/logs

# MySQL. Use host.docker.internal when MySQL runs on this Docker host.
MYSQL_HOST=host.docker.internal
MYSQL_USER=easyadmin
MYSQL_PASSWORD=CHANGE_ME

# Redis. Use host.docker.internal when Redis runs on this Docker host.
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=CHANGE_ME

# Mail credential encryption key. Keep this value stable after mail accounts are saved.
MAIL_CREDENTIAL_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_16_CHARACTERS

# Qiniu Kodo
OSS_QINIU_ACCESS_KEY=CHANGE_ME
OSS_QINIU_SECRET_KEY=CHANGE_ME
OSS_QINIU_BUCKET_NAME=easyadmin-prod
OSS_QINIU_DOMAIN=https://oss.example.com/

# Production API documentation (disabled by default)
KNIFE4J_ENABLE=false
KNIFE4J_BASIC_ENABLE=false
KNIFE4J_BASIC_USERNAME=admin
KNIFE4J_BASIC_PASSWORD=CHANGE_ME
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
